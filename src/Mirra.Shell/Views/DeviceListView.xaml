<UserControl x:Class="Mirra.Shell.Views.DeviceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:Mirra.Shell.Models"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Connect Device" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Setup Guide" Style="{StaticResource ButtonSecondary}" Command="{Binding OpenOnboardingCommand}" AutomationProperties.Name="Open Setup Guide" Margin="0,0,8,0"/>
                <Button Content="Diagnostics" Style="{StaticResource ButtonSecondary}" Command="{Binding OpenDiagnosticsCommand}" AutomationProperties.Name="Open Diagnostics"/>
            </StackPanel>
        </Grid>

        <!-- ── Main device list / cards ────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Device List Box -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="📱" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="No Android Device Detected" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Connect your phone with a USB cable and ensure USB Debugging is turned on."
                                   FontSize="13" Foreground="{DynamicResource BrushTextSecondary}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,8,0,20"/>
                        <Button Content="Open Setup Guide" Style="{StaticResource ButtonSecondary}" Command="{Binding OpenOnboardingCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Device List -->
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:DeviceInfo}">
                                <Border Background="{DynamicResource BrushSurfaceElevated}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1" CornerRadius="{StaticResource RadiusMD}"
                                        Padding="16" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="📱" FontSize="28" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16"/>
                                            <TextBlock Text="{Binding Serial}" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccess}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Settings Panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Session Options" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Text="Stream Quality" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox SelectedValue="{Binding QualityMode}" SelectedValuePath="Tag" Background="{DynamicResource BrushSurfaceElevated}" Margin="0,0,0,16" Padding="8">
                        <ComboBoxItem Content="High (1080p / 60 FPS)" Tag="high" IsSelected="True"/>
                        <ComboBoxItem Content="Medium (720p / 60 FPS)" Tag="medium"/>
                        <ComboBoxItem Content="Low (540p / 30 FPS)" Tag="low"/>
                    </ComboBox>

                    <CheckBox IsChecked="{Binding AudioForwarding}" Content="Forward Device Audio" Margin="0,0,0,12" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <CheckBox IsChecked="{Binding ClipboardSync}" Content="Sync Clipboard" Margin="0,0,0,24" Foreground="{DynamicResource BrushTextPrimary}"/>

                    <Border Background="{DynamicResource BrushSurfaceElevated}" Padding="12" CornerRadius="{StaticResource RadiusMD}">
                        <TextBlock Text="🔒 Direct USB connection. No cloud transfer or accounts required."
                                   FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Start Casting CTA ────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Button Content="Start Casting"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding StartCastingCommand}"
                    AutomationProperties.Name="Start Casting"
                    HorizontalAlignment="Right"
                    MinHeight="48" MinWidth="180" FontSize="16"/>
        </Grid>
    </Grid>
</UserControl>
