<Window x:Class="Mirra.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Mirra.Shell.ViewModels"
        xmlns:views="clr-namespace:Mirra.Shell.Views"
        Title="Mirra"
        MinWidth="900" MinHeight="600"
        Width="1100"   Height="720"
        Background="{DynamicResource BrushBackground}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Window chrome drag area -->
        <Style x:Key="TitleBar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="Height"     Value="48"/>
        </Style>

        <!-- ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type viewmodels:DeviceListViewModel}">
            <views:DeviceListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CastingViewModel}">
            <views:CastingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:OnboardingViewModel}">
            <views:OnboardingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DiagnosticsViewModel}">
            <views:DiagnosticsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>  <!-- Title bar -->
            <RowDefinition Height="*"/>   <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ── Custom title bar ─────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource TitleBar}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + App name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="◈" FontSize="20" Foreground="{DynamicResource BrushAccent}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Mirra" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button Click="MinimizeButton_Click" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize"
                            Style="{StaticResource ButtonSecondary}"
                            Padding="12,8" Margin="2,0" Content="—"/>
                    <Button Click="MaximizeButton_Click" ToolTip="Maximize/Restore"
                            AutomationProperties.Name="Maximize"
                            Style="{StaticResource ButtonSecondary}"
                            Padding="12,8" Margin="2,0" Content="□"/>
                    <Button Click="CloseButton_Click" ToolTip="Close"
                            AutomationProperties.Name="Close"
                            Style="{StaticResource ButtonSecondary}"
                            Padding="12,8" Margin="2,0" Content="✕"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main content area (navigated by NavigationService) ────────── -->
        <ContentControl Grid.Row="1"
                        x:Name="MainContentHost"
                        Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
