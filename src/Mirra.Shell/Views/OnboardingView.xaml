<UserControl x:Class="Mirra.Shell.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="0" Text="Android Connection Setup"
                   FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"
                   Margin="0,0,0,32"/>

        <!-- ── Step Cards ─────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Center">
            <StackPanel Margin="16">
                <!-- Step 1 -->
                <StackPanel>
                    <TextBlock Text="Step 1: Connect via USB Cable" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/>
                    <TextBlock Text="Use a high-quality USB cable supporting data transfer (not charge-only) and connect your Android phone to a USB port on your PC."
                               FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,8,0,24"/>
                </StackPanel>

                <!-- Step 2 -->
                <StackPanel>
                    <TextBlock Text="Step 2: Enable Developer Options &amp; USB Debugging" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/>
                    <TextBlock Text="1. Go to Settings > About Phone > Tap 'Build Number' 7 times.&#x0a;2. Go to Settings > System > Developer Options.&#x0a;3. Toggle on 'USB Debugging' (and 'USB Debugging (Security Settings)' on Xiaomi/MIUI)."
                               FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,8,0,24"/>
                </StackPanel>

                <!-- Step 3 -->
                <StackPanel>
                    <TextBlock Text="Step 3: Authorize RSA Fingerprint" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/>
                    <TextBlock Text="Unlock your phone. When the prompt 'Allow USB debugging?' appears, check 'Always allow from this computer' and tap 'Allow'."
                               FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Navigation ──────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,32,0,0">
            <Button Content="Back to Devices"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding SkipCommand}"
                    MinHeight="44" MinWidth="160"/>
        </StackPanel>
    </Grid>
</UserControl>
