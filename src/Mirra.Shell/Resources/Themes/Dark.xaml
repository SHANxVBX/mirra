<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Color Palette ─────────────────────────────────────────────────── -->
    <Color x:Key="ColorBackground">#FF0D0F14</Color>
    <Color x:Key="ColorSurface">#FF151A24</Color>
    <Color x:Key="ColorSurfaceElevated">#FF1C2333</Color>
    <Color x:Key="ColorBorder">#FF2A3349</Color>
    <Color x:Key="ColorAccent">#FF4F8EF7</Color>
    <Color x:Key="ColorAccentHover">#FF6BA3FF</Color>
    <Color x:Key="ColorAccentPressed">#FF3A72D4</Color>
    <Color x:Key="ColorSuccess">#FF34C759</Color>
    <Color x:Key="ColorWarning">#FFFFB830</Color>
    <Color x:Key="ColorError">#FFFF453A</Color>
    <Color x:Key="ColorTextPrimary">#FFF0F3FF</Color>
    <Color x:Key="ColorTextSecondary">#FF8B9AB8</Color>
    <Color x:Key="ColorTextMuted">#FF4A5568</Color>

    <!-- ── Brushes ────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushBackground"       Color="{StaticResource ColorBackground}"/>
    <SolidColorBrush x:Key="BrushSurface"          Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushSurfaceElevated"  Color="{StaticResource ColorSurfaceElevated}"/>
    <SolidColorBrush x:Key="BrushBorder"           Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushAccent"           Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentHover"      Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="BrushSuccess"          Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushWarning"          Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushError"            Color="{StaticResource ColorError}"/>
    <SolidColorBrush x:Key="BrushTextPrimary"      Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary"    Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted"        Color="{StaticResource ColorTextMuted}"/>

</ResourceDictionary>
